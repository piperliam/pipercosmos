% NASA GMAT Script - Lunar Photon (AAS 23-287) Matched 2024-2025 Escape Trajectory
% Trial 141 | Escape: 2024 DEC 24 23:36:28 | C3: +1.2926 km^2/s^2 | Sep2022 Rp: 8,071.9 km

%----------------------------------------
%---------- Spacecraft
%----------------------------------------
Create Spacecraft LunarPhoton;
GMAT LunarPhoton.DateFormat = UTCGregorian;
GMAT LunarPhoton.Epoch = '04 Jul 2022 08:09:38.816';
GMAT LunarPhoton.CoordinateSystem = EarthMJ2000Eq;
GMAT LunarPhoton.DisplayStateType = Cartesian;
GMAT LunarPhoton.X = 3775.9062454099;
GMAT LunarPhoton.Y = 18812.8198073500;
GMAT LunarPhoton.Z = 21949.8969139146;
GMAT LunarPhoton.VX = -1.609203269312;
GMAT LunarPhoton.VY = 4.022882933513;
GMAT LunarPhoton.VZ = 2.796737070393;
GMAT LunarPhoton.DryMass = 120;
GMAT LunarPhoton.Cd = 2.2;
GMAT LunarPhoton.Cr = 1.3;
GMAT LunarPhoton.DragArea = 1.8;
GMAT LunarPhoton.SRPArea = 1.1835;
GMAT LunarPhoton.OrbitColor = Red;
GMAT LunarPhoton.TargetColor = Teal;

%----------------------------------------
%---------- ForceModel & Propagator
%----------------------------------------
Create ForceModel DeepSpaceFM;
GMAT DeepSpaceFM.CentralBody = Earth;
GMAT DeepSpaceFM.PrimaryBodies = {Earth};
GMAT DeepSpaceFM.PointMasses = {Luna, Sun};
GMAT DeepSpaceFM.GravityField.Earth.Degree = 4;
GMAT DeepSpaceFM.GravityField.Earth.Order = 4;
GMAT DeepSpaceFM.SRP = On;

Create Propagator HighFidelityProp;
GMAT HighFidelityProp.FM = DeepSpaceFM;
GMAT HighFidelityProp.Type = PrinceDormand78;
GMAT HighFidelityProp.InitialStepSize = 60;
GMAT HighFidelityProp.Accuracy = 1e-11;
GMAT HighFidelityProp.MinStep = 0;
GMAT HighFidelityProp.MaxStep = 86400;

%----------------------------------------
%---------- Coordinate Systems
%----------------------------------------
Create CoordinateSystem EarthSunRot;
GMAT EarthSunRot.Origin = Earth;
GMAT EarthSunRot.Axes = ObjectReferenced;
GMAT EarthSunRot.XAxis = R;
GMAT EarthSunRot.ZAxis = N;
GMAT EarthSunRot.Primary = Sun;
GMAT EarthSunRot.Secondary = Earth;

Create CoordinateSystem EarthMoonRot;
GMAT EarthMoonRot.Origin = Earth;
GMAT EarthMoonRot.Axes = ObjectReferenced;
GMAT EarthMoonRot.XAxis = R;
GMAT EarthMoonRot.ZAxis = N;
GMAT EarthMoonRot.Primary = Earth;
GMAT EarthMoonRot.Secondary = Luna;

%----------------------------------------
%---------- Subscribers (Plots & Reports)
%----------------------------------------
Create OrbitView InertialView;
GMAT InertialView.SolverIterations = Current;
GMAT InertialView.UpperLeft = [ 0.00 0.00 ];
GMAT InertialView.Size = [ 0.50 0.50 ];
GMAT InertialView.RelativeZOrder = 10;
GMAT InertialView.Maximized = false;
GMAT InertialView.Add = {LunarPhoton, Earth, Luna};
GMAT InertialView.CoordinateSystem = EarthMJ2000Eq;
GMAT InertialView.DrawObject = [ true true true ];
GMAT InertialView.DataCollectFrequency = 5;
GMAT InertialView.UpdatePlotFrequency = 50;
GMAT InertialView.NumPointsToRedraw = 0;
GMAT InertialView.ShowPlot = true;
GMAT InertialView.MaxPlotPoints = 200000;
GMAT InertialView.ShowLabels = true;
GMAT InertialView.ViewPointReference = Earth;
GMAT InertialView.ViewPointVector = [ 0 0 2500000 ];
GMAT InertialView.ViewDirection = Earth;
GMAT InertialView.ViewScaleFactor = 1.2;
GMAT InertialView.ViewUpCoordinateSystem = EarthMJ2000Eq;
GMAT InertialView.ViewUpAxis = Y;
GMAT InertialView.UseInitialView = On;
GMAT InertialView.StarCount = 3000;
GMAT InertialView.EnableStars = On;
GMAT InertialView.EnableConstellations = Off;

Create OrbitView SunEarthRotView;
GMAT SunEarthRotView.SolverIterations = Current;
GMAT SunEarthRotView.UpperLeft = [ 0.50 0.00 ];
GMAT SunEarthRotView.Size = [ 0.50 0.50 ];
GMAT SunEarthRotView.RelativeZOrder = 11;
GMAT SunEarthRotView.Maximized = false;
GMAT SunEarthRotView.Add = {LunarPhoton, Earth, Luna};
GMAT SunEarthRotView.CoordinateSystem = EarthSunRot;
GMAT SunEarthRotView.DrawObject = [ true true true ];
GMAT SunEarthRotView.DataCollectFrequency = 5;
GMAT SunEarthRotView.UpdatePlotFrequency = 50;
GMAT SunEarthRotView.NumPointsToRedraw = 0;
GMAT SunEarthRotView.ShowPlot = true;
GMAT SunEarthRotView.MaxPlotPoints = 200000;
GMAT SunEarthRotView.ShowLabels = true;
GMAT SunEarthRotView.ViewPointReference = Earth;
GMAT SunEarthRotView.ViewPointVector = [ 0 0 3000000 ];
GMAT SunEarthRotView.ViewDirection = Earth;
GMAT SunEarthRotView.ViewScaleFactor = 1.2;
GMAT SunEarthRotView.ViewUpCoordinateSystem = EarthSunRot;
GMAT SunEarthRotView.ViewUpAxis = Y;
GMAT SunEarthRotView.UseInitialView = On;
GMAT SunEarthRotView.StarCount = 1000;
GMAT SunEarthRotView.EnableStars = Off;
GMAT SunEarthRotView.EnableConstellations = Off;

Create XYPlot RangeC3Plot;
GMAT RangeC3Plot.SolverIterations = Current;
GMAT RangeC3Plot.UpperLeft = [ 0.00 0.50 ];
GMAT RangeC3Plot.Size = [ 1.00 0.50 ];
GMAT RangeC3Plot.RelativeZOrder = 12;
GMAT RangeC3Plot.Maximized = false;
GMAT RangeC3Plot.XVariable = LunarPhoton.ElapsedDays;
GMAT RangeC3Plot.YVariables = {LunarPhoton.Earth.RMAG, LunarPhoton.Luna.RMAG};
GMAT RangeC3Plot.ShowGrid = true;
GMAT RangeC3Plot.ShowPlot = true;

Create ReportFile EphemReport;
GMAT EphemReport.Filename = 'lunar_photon_trial_141_ephem.txt';
GMAT EphemReport.Add = {LunarPhoton.UTCGregorian, LunarPhoton.ElapsedDays, LunarPhoton.Earth.RMAG, LunarPhoton.Earth.C3Energy, LunarPhoton.Luna.RMAG, LunarPhoton.EarthMJ2000Eq.RA, LunarPhoton.EarthMJ2000Eq.DEC};

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------
BeginMissionSequence;
Propagate HighFidelityProp(LunarPhoton) {LunarPhoton.ElapsedDays = 942};
